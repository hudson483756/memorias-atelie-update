<UserControl x:Class="MemoriasAtelie.TelaAgendaAnual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF9FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecalho de Navegacao -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.1" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- Visao Anual Header -->
                <StackPanel x:Name="PanelNavegacaoAno" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Visible">
                    <Button Content="◄" Width="30" Height="30" Click="BtnAnoAnterior_Click" Background="Transparent" BorderThickness="0" Foreground="#B76E79" FontWeight="Bold" FontSize="16" Cursor="Hand"/>
                    <TextBlock x:Name="TxtAnoAtual" Text="2026" FontSize="22" FontWeight="Bold" Foreground="#2F4F4F" Margin="16,0" VerticalAlignment="Center"/>
                    <Button Content="►" Width="30" Height="30" Click="BtnProximoAno_Click" Background="Transparent" BorderThickness="0" Foreground="#B76E79" FontWeight="Bold" FontSize="16" Cursor="Hand"/>
                </StackPanel>

                <!-- Visao Mensal Header -->
                <Grid x:Name="PanelNavegacaoMes" Visibility="Collapsed">
                    <Button Content="◄ Voltar ao Ano" HorizontalAlignment="Left" Click="BtnVoltarAno_Click" Background="Transparent" BorderThickness="0" Foreground="#B76E79" FontWeight="Bold" Cursor="Hand"/>
                    <TextBlock x:Name="TxtMesAnoSelecionado" Text="Janeiro de 2026" FontSize="20" FontWeight="Bold" Foreground="#2F4F4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Conteudo Principal -->
        <Grid Grid.Row="1">
            <!-- Grid de Meses (Visao Anual) -->
            <ScrollViewer x:Name="ScrollViewerAnual" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsMeses">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6" Background="White" CornerRadius="12" Padding="12" Cursor="Hand" MouseLeftButtonDown="CardMes_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="Black"/>
                                </Border.Effect>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NomeMes}" FontSize="16" FontWeight="Bold" Foreground="#2F4F4F" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalFormatado}" FontSize="13" FontWeight="SemiBold" Foreground="#B76E79" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Grid de Encomendas (Visao Mensal - Estilo Galeria Compacta 5 Colunas) -->
            <Grid x:Name="GridMensal" Visibility="Collapsed">
                <TextBlock x:Name="TxtSemEncomendas" Text="Nenhuma encomenda para este mês." FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <ScrollViewer x:Name="ScrollViewerMensal" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsEncomendas">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Layout de 5 colunas -->
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Background="White" CornerRadius="8" Padding="0" Cursor="Hand" ClipToBounds="True" MouseLeftButtonDown="CardEncomenda_Click">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                                    </Border.Effect>

                                    <!-- Card compacto com 150px de altura total -->
                                    <Grid Height="150">
                                        <Grid.RowDefinitions>
                                            <!-- Área da Imagem com 100px -->
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Container da foto com fundo Branco (fundido ao card) -->
                                        <Grid Grid.Row="0" Background="White">
                                            <Image Source="{Binding CaminhoImagemCompleto}" 
                                                   Stretch="Uniform" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Visibility="{Binding VisibilidadeImagem}"/>
                                            <TextBlock Text="🎁" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VisibilidadePlaceholder}"/>
                                        </Grid>

                                        <!-- Detalhes compactos do produto e cliente -->
                                        <StackPanel Grid.Row="1" Margin="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Produto}" FontWeight="Bold" FontSize="11" Foreground="#2F4F4F" TextTrimming="CharacterEllipsis" ToolTip="{Binding Produto}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="👤 " FontSize="9" Foreground="Gray"/>
                                                <TextBlock Text="{Binding NomeCliente}" FontSize="10" Foreground="#555555" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>